<?xml version="1.0" encoding="utf-8"?>
<!-- Condivisione tra le TV: the NAS folder the TVs of the house share "Ultimi contenuti" through.
     Over the Home's blurred landscape, like the apps panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0E1E">

    <!-- Full screen: the whole blurred scene and its tint, as a backdrop. -->
    <com.cosyhome.tv.GlassPanel
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="backdrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp"
        android:orientation="horizontal">

        <!-- Left: what this is and how it is doing. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:layout_marginEnd="40dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:text="@string/nas_title"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/nas_intro"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/nasDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/nasStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nasStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/nas_fritz_hint"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right: the settings, on glass. -->
        <com.cosyhome.tv.GlassPanel
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nasOn"
                    style="@style/Chip"
                    android:layout_marginTop="6dp"
                    android:nextFocusUp="@id/nasOn"
                    android:text="@string/nas_on" />

                <TextView style="@style/FieldLabel" android:text="@string/nas_host" />

                <EditText
                    android:id="@+id/nasHost"
                    style="@style/Field"
                    android:hint="@string/nas_host_hint"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/FieldLabel" android:text="@string/nas_user" />

                        <EditText
                            android:id="@+id/nasUser"
                            style="@style/Field"
                            android:hint="@string/nas_user_hint"
                            android:inputType="text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/FieldLabel" android:text="@string/nas_password" />

                        <EditText
                            android:id="@+id/nasPassword"
                            style="@style/Field"
                            android:inputType="textPassword" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="@string/nas_dir" />

                <EditText
                    android:id="@+id/nasDir"
                    style="@style/Field"
                    android:hint="@string/nas_dir_hint"
                    android:inputType="textUri" />

                <TextView style="@style/FieldLabel" android:text="@string/nas_tv_name" />

                <EditText
                    android:id="@+id/nasTvName"
                    style="@style/Field"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nasTest"
                        style="@style/Chip"
                        android:text="@string/nas_test" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/nasCancel"
                        style="@style/Chip"
                        android:layout_marginEnd="8dp"
                        android:text="@android:string/cancel" />

                    <TextView
                        android:id="@+id/nasSave"
                        style="@style/Chip"
                        android:text="@string/nas_save" />
                </LinearLayout>
            </LinearLayout>
        </com.cosyhome.tv.GlassPanel>
    </LinearLayout>
</FrameLayout>
