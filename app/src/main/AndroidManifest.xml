<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Weather for the clock (Open-Meteo, no account). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- What you were watching: the system's Watch Next table. Granted over ADB. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Android 11+ package visibility: the apps shown as tiles, and the Philips screens the chips open. -->
    <queries>
        <!-- The Philips channel list. -->
        <provider android:authorities="org.droidtv.epgdvb" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.droidtv.action.AMBILIGHT_OSD" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Cosy"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <!-- Listed in the stock launcher's app list too, so it can be opened before it owns Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Off until approved: a disabled alias leaves the TV's current Home preference alone.
             Turned on over ADB through HomeSwitch below. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".HomeSwitch"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.famiglia.home.HOME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
